# Minimal BusyBox init layout for isolated Alpine user rootfs.
# BusyBox is namespace PID 1; OpenRC manages user-side service runlevels.
::sysinit:/sbin/openrc sysinit
::sysinit:/sbin/openrc boot
::wait:/sbin/openrc default
::respawn:/bin/busybox getty -L -n -l /usr/local/sbin/veyra-stage1-autologin 115200 console vt100
::shutdown:/sbin/openrc shutdown
