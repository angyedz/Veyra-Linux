# Installs the pinned glenv installer and package helper, not the full Debian sysroot.
pkgname=veyra-glenv
pkgver=1.1
pkgrel=2
pkgdesc="Pinned glenv runtime installer, authenticated Debian package manager, and Wayland shim"
url="https://github.com/angyedz/glenv"
arch="x86_64"
license="MIT"
depends="bash ca-certificates curl debian-archive-keyring gpgv python3 tar xz zstd"
makedepends="git"
options="!check"
_glenv_commit=720b89b91dc6fc648533ee75155b2120cfad4c70
source=""
builddir="$srcdir"

build() {
    git clone -q "$url.git" "$builddir/glenv"
    git -C "$builddir/glenv" checkout -q "$_glenv_commit"
}

package() {
    install -Dm755 "$builddir/glenv/install.sh" "$pkgdir/usr/share/veyra/glenv/install.sh"
    install -Dm755 "$builddir/glenv/tools/fetch-deps.py" "$pkgdir/usr/share/veyra/glenv/tools/fetch-deps.py"
    install -Dm755 "$builddir/glenv/bin/glenv" "$pkgdir/usr/share/veyra/glenv/bin/glenv"
    install -Dm755 "$builddir/glenv/lib/glenv-wayland-filter.so" "$pkgdir/usr/share/veyra/glenv/lib/glenv-wayland-filter.so"
    install -Dm755 "$startdir/veyra-glenv" "$pkgdir/usr/bin/veyra-glenv"
}
