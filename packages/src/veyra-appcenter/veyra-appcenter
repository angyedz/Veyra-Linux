#!/bin/sh
set -eu
command -v kdialog >/dev/null || { echo 'Install kdialog' >&2; exit 1; }
while :; do
 action=$(kdialog --title 'Veyra AppCenter' --menu 'Manage applications' search 'Search APK packages' install 'Install APK package' remove 'Remove APK package' nix 'Nix catalog instructions') || exit 0
 case "$action" in
 search)
   query=$(kdialog --title 'Search packages' --inputbox 'Package name or keyword:') || continue
   [ -n "$query" ] || continue
   result=$(apk search -v -- "$query" | head -80) || :
   [ -n "$result" ] || result='No matches found.'
   kdialog --title 'APK search results' --msgbox "$result"
   ;;
 install|remove)
   name=$(kdialog --title 'Veyra AppCenter' --inputbox 'Exact APK package name:') || continue
   case "$name" in ''|*[!a-zA-Z0-9._+@-]*) kdialog --error 'Invalid package name'; continue ;; esac
   kdialog --yesno "Run apk $([ "$action" = install ] && echo add || echo del) for $name?" || continue
   command -v pkexec >/dev/null || { kdialog --error 'pkexec is required for administrative actions'; continue; }
   if [ "$action" = install ]; then pkexec apk add -- "$name"; else pkexec apk del -- "$name"; fi
   ;;
 nix)
   kdialog --msgbox 'Nix packages can be managed with vpkg:\nvpkg search NAME --from nix\nvpkg install NAME --from nix'
   ;;
 esac
done
