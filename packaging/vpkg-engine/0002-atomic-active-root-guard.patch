diff --git a/src/apk.c b/src/apk.c
--- a/src/apk.c
+++ b/src/apk.c
@@ -566,6 +566,38 @@ int main(int argc, char **argv)
 	apk_flags |= APK_SIMULATE;
 	apk_flags &= ~APK_INTERACTIVE;
 #endif
+	/*
+	 * Veyra's atomic host must never have its active root altered by the
+	 * package engine itself, even if callers bypass the Go vpkg frontend.
+	 * A separately selected, inactive --root is allowed for staging.
+	 * This is a policy safety guard, NOT a boundary against root users.
+	 */
+	if (dbopts.open_flags & (APK_OPENF_WRITE | APK_OPENF_CACHE_WRITE)) {
+		FILE *mode = fopen("/etc/veyra/deployment-mode", "r");
+		if (mode) {
+			char value[64];
+			char *resolved = NULL;
+			int atomic = 0, invalid = 0;
+			if (!fgets(value, sizeof value, mode)) invalid = 1;
+			else if (!strcmp(value, "atomic-v1\n") || !strcmp(value, "atomic-v1"))
+				atomic = 1;
+			else if (strcmp(value, "legacy\n") && strcmp(value, "legacy"))
+				invalid = 1;
+			fclose(mode);
+			if (atomic) {
+				if (dbopts.root) resolved = realpath(dbopts.root, NULL);
+				if (resolved == NULL || !strcmp(resolved, "/")) invalid = 1;
+				free(resolved);
+			}
+			if (invalid) {
+				apk_error("Veyra atomic policy rejects modifications of the active system root");
+				goto err;
+			}
+		} else if (errno != ENOENT) {
+			apk_error("Could not read Veyra system policy");
+			goto err;
+		}
+	}
 	r = apk_db_open(&db, &dbopts);
